# DeepLearnLib

PROJECT_NAME           = "DeepLearnLib"
PROJECT_BRIEF          = "C++/CUDA library for training and inference"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           = docs/doxygen-warnings.txt
INPUT                  = README.md \
                         INSTALL.md \
                         include/DeepLearnLib \
                         benchmarks/models \
                         docs/README.md \
                         docs/library \
                         docs/usage \
                         reports/loc.md \
                         reports/coverage.md
FILE_PATTERNS          = *.hpp \
                         *.h \
                         *.md
RECURSIVE              = YES
EXCLUDE                = benchmarks/models/torch
EXCLUDE_PATTERNS       = */torch/*
USE_MDFILE_AS_MAINPAGE = README.md
SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
HAVE_DOT               = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SKIP_FUNCTION_MACROS   = YES
PREDEFINED             = DEEPLEARNLIB_ENABLE_CUDA=1 \
                         DEEPLEARNLIB_HAS_NVTX=0 \
                         DL_HOST_DEVICE= \
                         DL_PAIRED_UNIFORM_ATTR=
QUIET                  = YES
SORT_MEMBER_DOCS       = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
